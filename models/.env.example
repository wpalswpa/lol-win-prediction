# models/.env — 모델 API 서버 설정. 이 파일을 .env 로 복사해 값을 바꾼다 (코드는 안 고친다).
#   cp models/.env.example models/.env
PORT=9544
HOST=0.0.0.0
# 접전 판단보류 폭 (|확률-0.5| 가 이보다 작으면 «판단보류»)
CLOSE_MARGIN=0.10
# 이상탐지 결과를 응답에 넣을지
INCLUDE_ANOMALY=true
# 브라우저에서 직접 부르는 외부 서비스 오리진. 여러 개는 쉼표. 비우면 CORS 헤더를 내지 않는다
CORS_ORIGINS=*
# 외부 공개 시 호출자 구분용 키 (쉼표 구분). 비어 있으면 검사하지 않는다
API_KEYS=
