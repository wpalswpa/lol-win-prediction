      <bpmndi:BPMNShape id="Lane_bpmn_uc08_2_di" bpmnElement="Lane_bpmn_uc08_2" isHorizontal="true"><dc:Bounds x="70" y="634.5" width="4478" height="313.0" /></bpmndi:BPMNShape>
